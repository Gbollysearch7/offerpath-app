# Supabase. The production project is "levelup" in the supabase-new organisation. See docs/RELEASE_RUNBOOK.md for every variable.
# Leave these empty to run in demo mode with fictional sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required with Supabase: reports, scores and judgments are written by the server only.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Required in production: the public address of the app. Sign-in emails and SSO return here.
NEXT_PUBLIC_SITE_URL=

# Enables Claude: Haiku judges CV bullets for scoring; Opus writes rewrites and letter drafts.
# Without it, Offerpath scores and writes with its rule engine.
ANTHROPIC_API_KEY=

# Optional. Secret for signing demo-mode session cookies. If unset, a random one is made at startup.
DEMO_SECRET=
# Production only: "true", with no Supabase variable set, runs the fictional demo on purpose. Without it, a server with
# no database refuses every sign-in rather than opening a demo.
DEMO_MODE=
# Demo mode only: stands in for the per-university report sharing setting, which is off by default.
DEMO_REPORT_SHARING=

# Universities whose SAML provider is connected in Supabase, as Name=domain, separated by semicolons:
# SSO_UNIVERSITIES="University of Example=example.ac.uk". Empty: the sign-in page offers the email link only.
SSO_UNIVERSITIES=

# Email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Offerpath <no-reply@your-domain>
SUPPORT_EMAIL=

# Scheduled jobs: Vercel Cron sends this as a Bearer token. Without it, the jobs refuse to run.
CRON_SECRET=
# Delete student accounts after this many months of inactivity (warned 30 days before). Default 24.
RETENTION_INACTIVE_MONTHS=24

# Monitoring: Slack/Teams/Discord incoming webhook for alerts (server errors, AI failures).
ALERT_WEBHOOK_URL=

# Legal page details (shown as placeholders until set). Needed before launch; nothing warns if they are missing.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_COMPANY_NUMBER=
LEGAL_ICO_NUMBER=
LEGAL_CONTACT_EMAIL=

# Proofreading runs locally with no setup. See "Proofreading" in docs/DEPLOY.md before changing these.
PROOFREADING_LANGUAGE=
PROOFREADING_TIMEOUT_MS=
PROOFREADING_PROVIDER=

# Optional. Adviser access to shared CVs: leave unset until legal review ("true" turns it on).
ADVISER_CV_ACCESS=
# Optional. Privacy-friendly analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Local development only. "true" shows one-click test sign-in buttons. Ignored on any production or preview deployment.
TEST_LOGIN=
