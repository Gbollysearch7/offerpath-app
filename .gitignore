# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# calibration CVs (personal data)
/calibration/*
!/calibration/README.md
!/calibration/adviser_scores.example.csv

# supabase CLI cache
/supabase/.temp/

# stageshow skill: its tools and the practice copies of the landing demos (the shipped demos live in src/app/_landing/demos)
/.agents/skills/stageshow/node_modules/
/.agents/skills/stageshow/examples/op-*/
