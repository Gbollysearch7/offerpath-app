{
  "name": "offerpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node supabase/tests/schema.test.mjs",
    "test:engine": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "test": "npm run test:engine && npm run test:db",
    "typecheck": "tsc --noEmit",
    "calibrate": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/calibrate.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:live": "node --env-file=.env.local tests/e2e/live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.14.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
